# Optional runtime settings. Copy to .env only if your launcher loads dotenv files.
# The application reads these values from the process environment; no dotenv package is required.
LCAI_DATABASE_PATH=data/objectif_brevet_2027.duckdb
LCAI_V2_DATABASE_PATH=data/learning_coach_v2.duckdb
LCAI_ENABLE_V2_UI=false
LCAI_ENABLE_V2_ADMIN=false
HOMEWORK_AI_FALLBACK_4E_ENABLED=false
HOMEWORK_AI_FALLBACK_MAX_RETRY=1
HOMEWORK_AI_FALLBACK_TIMEOUT_SECONDS=30
HOMEWORK_RECENT_EXCLUSION_DAYS=30
HOMEWORK_AI_MAX_GENERATED_PER_REQUEST=10
HOMEWORK_AI_ALLOW_DEGRADED_RESULT=true
LCAI_LOG_LEVEL=INFO
